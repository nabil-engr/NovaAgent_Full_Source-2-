<Application x:Class="NovaAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B1020"/>
        <SolidColorBrush x:Key="Panel" Color="#121A2E"/>
        <SolidColorBrush x:Key="Panel2" Color="#17213A"/>
        <SolidColorBrush x:Key="Text" Color="#F3F6FF"/>
        <SolidColorBrush x:Key="Muted" Color="#9EACC9"/>
        <SolidColorBrush x:Key="Accent" Color="#77A0FF"/>
        <SolidColorBrush x:Key="Accent2" Color="#5DE0C1"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6B7A"/>
        <SolidColorBrush x:Key="Border" Color="#263554"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#2A3A5F"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#081020"/>
            <Setter Property="Background" Value="{StaticResource Accent2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent2}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0E172B"/>
            <Setter Property="BorderBrush" Value="#2A3A5F"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="Background" Value="#F3F6FF"/>
            <Setter Property="BorderBrush" Value="#42557D"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="4,6"/>
        </Style>
    </Application.Resources>
</Application>
