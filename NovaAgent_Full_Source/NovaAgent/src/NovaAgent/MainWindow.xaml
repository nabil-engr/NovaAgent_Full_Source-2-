<Window x:Class="NovaAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Agent" Width="1120" Height="800"
        MinWidth="900" MinHeight="680" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource Accent2}" CornerRadius="10" Width="48" Height="48">
                    <TextBlock Text="N" Foreground="#081020" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,1,0,0">
                    <TextBlock Text="NOVA AGENT" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Private, local Windows automation" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#142A30" BorderBrush="#276A5C" BorderThickness="1"
                    CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Accent2}"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="ASSISTANT">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Voice control" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="TranscriptText" Text="Last heard: —" FontSize="16"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="StartButton" Content="Start listening" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                                        <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"/>
                                        <Button x:Name="ListenOnceButton" Content="Listen once" Click="ListenOnce_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Command console" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Test every action without using the microphone. Press Enter to run."
                                               Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Run command" Style="{StaticResource PrimaryButton}"
                                                Click="RunTextCommand_Click" Margin="10,0,0,0"/>
                                        <TextBox x:Name="CommandBox" Height="44" VerticalContentAlignment="Center"
                                                 Text="downloads folder open" KeyDown="CommandBox_KeyDown"/>
                                    </DockPanel>
                                    <TextBlock x:Name="CurrentContextText" Text="Current folder: Downloads"
                                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <Button Content="Open Downloads" Tag="downloads folder open" Click="QuickCommand_Click"/>
                                        <Button Content="Volume 50%" Tag="volume 50" Click="QuickCommand_Click"/>
                                        <Button Content="Play / Pause" Tag="play" Click="QuickCommand_Click"/>
                                        <Button Content="New browser tab" Tag="new tab" Click="QuickCommand_Click"/>
                                        <Button Content="Screenshot" Tag="screenshot" Click="QuickCommand_Click"/>
                                        <Button Content="Help" Tag="help" Click="QuickCommand_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Stored only on this PC" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
                            </StackPanel>
                            <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Command}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Result}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Time, StringFormat={}{0:g}}" Foreground="#647495" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="Export CSV" Click="ExportHistory_Click"/>
                                <Button Content="Clear" Click="ClearHistory_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="AlwaysListeningCheck" Content="Start listening when Nova opens"/>
                                    <CheckBox x:Name="RequireWakeCheck" Content="Require wake word"/>
                                    <CheckBox x:Name="SpeakCheck" Content="Speak responses"/>
                                    <CheckBox x:Name="AutoStartCheck" Content="Start with Windows"/>
                                    <CheckBox x:Name="CloseTrayCheck" Content="Close window to system tray"/>
                                    <TextBlock Text="Wake words (comma separated)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="WakeWordsBox"/>
                                    <TextBlock Text="Conversation window in seconds (8–120)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="ConversationBox"/>
                                    <TextBlock Text="Audio chunk in milliseconds (2000–10000)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="ChunkBox"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Audio &amp; speech" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Microphone" Foreground="{StaticResource Muted}" Margin="4,0,4,4"/>
                                    <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="Name" SelectedValuePath="Number"/>
                                    <TextBlock Text="Voice rate (-10 to 10)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="SpeechRateBox"/>
                                    <TextBlock Text="Voice volume (0 to 100)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="SpeechVolumeBox"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Local Whisper runtime" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Server executable" Foreground="{StaticResource Muted}" Margin="4,0,4,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseWhisperServer_Click" Margin="8,0,0,0"/>
                                        <TextBox x:Name="WhisperServerBox" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="Multilingual model" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseWhisperModel_Click" Margin="8,0,0,0"/>
                                        <TextBox x:Name="WhisperModelBox" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="Maximum files scanned per search (1000–100000)" Foreground="{StaticResource Muted}" Margin="4,12,4,4"/>
                                    <TextBox x:Name="FileSearchLimitBox"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Custom app aliases" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="One alias=executable path per line. Environment variables are supported."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBox x:Name="CustomAppsBox" Height="105" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Import settings" Click="ImportSettings_Click"/>
                                <Button Content="Export settings" Click="ExportSettings_Click"/>
                                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="DIAGNOSTICS">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Open app data" Click="OpenAppData_Click"/>
                                <Button Content="Open log" Click="OpenLog_Click"/>
                                <Button Content="Run checks" Style="{StaticResource PrimaryButton}" Click="RunDiagnostics_Click"/>
                            </WrapPanel>
                            <StackPanel>
                                <TextBlock Text="System health" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock x:Name="DiagnosticsSummaryText" Text="Run checks to validate this PC."
                                           Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="DiagnosticsList" Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Suggestion}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
